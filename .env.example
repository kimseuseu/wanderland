# Discord OAuth (Discord Developer Portal에서 발급)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# NextAuth
NEXTAUTH_SECRET=    # openssl rand -base64 32 로 생성
NEXTAUTH_URL=http://localhost:3000

# Neon Postgres (Vercel에서 Neon 연결 시 자동 설정됨)
DATABASE_URL=

# Discord Bot (블랙리스트 슬래시 커맨드용)
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_GUILD_ID_2=        # 두 번째 서버 ID (선택)
DISCORD_BOT_CHANNEL_IDS=       # 허용 채널 ID (쉼표 구분)
